OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=Smart Parser
AI_ENABLED=true

# Avito low-request mode. Leave proxy empty when routed via your direct Russian IP.
AVITO_PROXY_URLS=
AVITO_HEADLESS=true
AVITO_RESET_SESSION_EACH_REQUEST=true
AVITO_PERSIST_SESSION=false
AVITO_MIN_REQUEST_INTERVAL_S=15
AVITO_POST_LOAD_DELAY_S=2
AVITO_BLOCK_HEAVY_RESOURCES=true
AVITO_STORAGE_STATE_PATH=data/avito_storage_state.json
AVITO_MANUAL_CAPTCHA_TIMEOUT_S=180
AVITO_TIMEOUT_MS=45000
AVITO_MAX_PAGES=2
AVITO_MAX_ITEMS=80
AVITO_MAX_DETAILS=0

WEB_SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

DEEP_ANALYSIS_TOP_N=0
VISION_MAX_IMAGES=0
LLM_BATCH_SIZE=12
MINIMUM_COMPARABLES=3
